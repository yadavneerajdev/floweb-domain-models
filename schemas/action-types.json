{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floweb.com/schemas/action-types.json",
  "$version": "1.4.0",
  "title": "Action Types",
  "description": "Canonical registry of automation action-type identifiers. The runtime strings are uniform camelCase across all consumers (AI catalog, backend factory/recorder, frontend, config classes); this schema is the single source. Config class names still diverge from the string in some cases (fillForm->FormFillConfig, dbQuery->DatabaseQueryConfig, dbInsert->DatabaseInsertConfig, custom->CustomCodeConfig) \u2014 that alignment is tracked in the backend/action-configs plans, not here.",
  "type": "object",
  "properties": {
    "actionType": {
      "$ref": "#/$defs/ActionType"
    }
  },
  "$defs": {
    "ActionType": {
      "type": "string",
      "description": "Every automation action-type identifier (29 web + 18 desktop + 15 mobile + 3 api + 4 integrations + 6 core = 75).",
      "enum": [
        "click",
        "input",
        "sendKeys",
        "wait",
        "navigate",
        "scroll",
        "screenshot",
        "assertion",
        "assertVisible",
        "fillForm",
        "clearInput",
        "openNewTab",
        "switchTab",
        "goForward",
        "goBack",
        "refresh",
        "getPageInfo",
        "setViewport",
        "apiCall",
        "networkControl",
        "accessibilityAudit",
        "captureWebVitals",
        "visualRegression",
        "loadDataset",
        "conditional",
        "loop",
        "dbQuery",
        "dbInsert",
        "custom",
        "dragAndDrop",
        "callToFlow",
        "switchToFrame",
        "exitFrame",
        "getElementProperties",
        "handlePopup",
        "fileUpload",
        "fileDownload",
        "junction",
        "desktopWaitForImage",
        "desktopVerifyImage",
        "desktopFindImage",
        "desktopClickImage",
        "desktopClickPoint",
        "desktopTypeText",
        "desktopFillForm",
        "desktopMoveMouse",
        "desktopDragAndDrop",
        "desktopHotkey",
        "desktopRunCommand",
        "desktopRunScript",
        "desktopCaptureScreen",
        "desktopFocusWindow",
        "desktopOpenApplication",
        "desktopSwitchDesktop",
        "desktopListProcesses",
        "desktopOpenPath",
        "mobileLaunchApp",
        "mobileTerminateApp",
        "mobileInstallApp",
        "mobileTapElement",
        "mobileTypeText",
        "mobileLongPress",
        "mobileSwipe",
        "mobileScrollToElement",
        "mobileWaitForElement",
        "mobileVerifyElement",
        "mobileGetElementProperties",
        "mobileCaptureScreen",
        "mobilePressKey",
        "mobileSetOrientation",
        "mobileHideKeyboard",
        "gmail",
        "slack",
        "discord",
        "jira"
      ]
    },
    "DesktopActionType": {
      "type": "string",
      "description": "The 18 desktop automation action types (subset of ActionType).",
      "enum": [
        "desktopWaitForImage",
        "desktopVerifyImage",
        "desktopFindImage",
        "desktopClickImage",
        "desktopClickPoint",
        "desktopTypeText",
        "desktopFillForm",
        "desktopMoveMouse",
        "desktopDragAndDrop",
        "desktopHotkey",
        "desktopRunCommand",
        "desktopRunScript",
        "desktopCaptureScreen",
        "desktopFocusWindow",
        "desktopOpenApplication",
        "desktopSwitchDesktop",
        "desktopListProcesses",
        "desktopOpenPath"
      ]
    },
    "MobileActionType": {
      "type": "string",
      "description": "The 15 native mobile (iOS/Android) automation action types, run via Appium (subset of ActionType). Deliberately platform-neutral — no per-platform action types — the config/handler branches on the live Appium session's platform instead.",
      "enum": [
        "mobileLaunchApp",
        "mobileTerminateApp",
        "mobileInstallApp",
        "mobileTapElement",
        "mobileTypeText",
        "mobileLongPress",
        "mobileSwipe",
        "mobileScrollToElement",
        "mobileWaitForElement",
        "mobileVerifyElement",
        "mobileGetElementProperties",
        "mobileCaptureScreen",
        "mobilePressKey",
        "mobileSetOrientation",
        "mobileHideKeyboard"
      ]
    },
    "IntegrationActionType": {
      "type": "string",
      "description": "Actions that call an external application's API.",
      "enum": [
        "gmail",
        "slack",
        "discord",
        "jira"
      ]
    },
    "WebActionType": {
      "type": "string",
      "description": "The 29 browser/DOM action types that require a live page context (subset of ActionType).",
      "enum": [
        "click",
        "input",
        "sendKeys",
        "scroll",
        "dragAndDrop",
        "fillForm",
        "clearInput",
        "assertion",
        "assertVisible",
        "getElementProperties",
        "switchToFrame",
        "exitFrame",
        "handlePopup",
        "fileUpload",
        "fileDownload",
        "navigate",
        "goForward",
        "goBack",
        "refresh",
        "openNewTab",
        "switchTab",
        "getPageInfo",
        "setViewport",
        "screenshot",
        "custom",
        "networkControl",
        "accessibilityAudit",
        "captureWebVitals",
        "visualRegression"
      ]
    },
    "ApiActionType": {
      "type": "string",
      "description": "The 3 direct service-call action types: generic HTTP calls and database queries (subset of ActionType).",
      "enum": [
        "apiCall",
        "dbQuery",
        "dbInsert"
      ]
    },
    "CoreActionType": {
      "type": "string",
      "description": "The 6 platform-agnostic control-flow and generic utility action types that need neither a browser nor OS automation (subset of ActionType).",
      "enum": [
        "conditional",
        "loop",
        "junction",
        "callToFlow",
        "wait",
        "loadDataset"
      ]
    }
  }
}
