{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floweb.com/schemas/action-types.json",
  "$version": "1.2.0",
  "title": "Action Types",
  "description": "Canonical registry of automation action-type identifiers. The runtime strings are uniform camelCase across all consumers (AI catalog, backend factory/recorder, frontend, config classes); this schema is the single source. Config class names still diverge from the string in some cases (fillForm->FormFillConfig, dbQuery->DatabaseQueryConfig, dbInsert->DatabaseInsertConfig, custom->CustomCodeConfig) — that alignment is tracked in the backend/action-configs plans, not here.",
  "type": "object",
  "properties": {
    "actionType": { "$ref": "#/$defs/ActionType" }
  },
  "$defs": {
    "ActionType": {
      "type": "string",
      "description": "Every automation action-type identifier (33 web + 17 desktop = 50).",
      "enum": [
        "click",
        "input",
        "sendKeys",
        "wait",
        "navigate",
        "scroll",
        "screenshot",
        "assertion",
        "assertVisible",
        "fillForm",
        "clearInput",
        "openNewTab",
        "switchTab",
        "goForward",
        "goBack",
        "refresh",
        "getPageInfo",
        "setViewport",
        "apiCall",
        "networkControl",
        "conditional",
        "loop",
        "dbQuery",
        "dbInsert",
        "custom",
        "dragAndDrop",
        "callToFlow",
        "switchToFrame",
        "exitFrame",
        "getElementProperties",
        "handlePopup",
        "fileUpload",
        "fileDownload",
        "junction",
        "desktopWaitForImage",
        "desktopVerifyImage",
        "desktopFindImage",
        "desktopClickImage",
        "desktopClickPoint",
        "desktopTypeText",
        "desktopMoveMouse",
        "desktopDragAndDrop",
        "desktopHotkey",
        "desktopRunCommand",
        "desktopRunScript",
        "desktopCaptureScreen",
        "desktopFocusWindow",
        "desktopOpenApplication",
        "desktopSwitchDesktop",
        "desktopListProcesses",
        "desktopOpenPath"
      ]
    },
    "DesktopActionType": {
      "type": "string",
      "description": "The 17 desktop automation action types (subset of ActionType).",
      "enum": [
        "desktopWaitForImage",
        "desktopVerifyImage",
        "desktopFindImage",
        "desktopClickImage",
        "desktopClickPoint",
        "desktopTypeText",
        "desktopMoveMouse",
        "desktopDragAndDrop",
        "desktopHotkey",
        "desktopRunCommand",
        "desktopRunScript",
        "desktopCaptureScreen",
        "desktopFocusWindow",
        "desktopOpenApplication",
        "desktopSwitchDesktop",
        "desktopListProcesses",
        "desktopOpenPath"
      ]
    }
  }
}
