{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floweb.com/schemas/flow.json",
  "$version": "1.1.0",
  "title": "Flow",
  "description": "Complete flow definition for automation workflows",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the flow"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the flow"
    },
    "description": {
      "type": "string",
      "description": "Optional description of the flow"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorization and filtering"
    },
    "parentID": {
      "type": [
        "string",
        "null"
      ],
      "description": "Parent folder ID for organization"
    },
    "type": {
      "type": "string",
      "enum": [
        "flow",
        "test",
        "performance"
      ],
      "default": "flow",
      "description": "Type of the flow"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Action"
      },
      "description": "List of actions in the flow"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "description": "Connections between actions"
    },
    "zoom": {
      "$ref": "#/$defs/Zoom",
      "description": "Canvas zoom and pan state"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    },
    "variables": {
      "$ref": "#/$defs/FlowVariables",
      "default": null,
      "description": "Flow input and output variables"
    },
    "parameters": {
      "$ref": "#/$defs/FlowParameters",
      "default": null,
      "description": "Flow parameters for configuration"
    },
    "environment": {
      "$ref": "#/$defs/Environment",
      "description": "Environment configuration"
    },
    "globalVariables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GlobalVariable"
      },
      "description": "Global variables available to the flow"
    },
    "synced": {
      "type": "boolean",
      "description": "Whether the flow is synced with server"
    },
    "lastRun": {
      "type": "string",
      "format": "date-time",
      "description": "Last execution timestamp"
    },
    "lastResult": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "pending",
        "running"
      ],
      "description": "Result of last execution"
    },
    "assistantAuditHistory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AssistantAuditEntry"
      },
      "description": "History of AI-assistant edits applied to this flow"
    }
  },
  "required": [
    "id",
    "name",
    "actions",
    "edges"
  ],
  "$defs": {
    "AssistantAuditOperation": {
      "type": "object",
      "description": "A single tool operation performed by the AI assistant",
      "properties": {
        "tool": {
          "type": "string",
          "description": "Tool name that was invoked"
        },
        "summary": {
          "type": "string",
          "description": "Human-readable summary of the operation"
        },
        "payload": {
          "type": "object",
          "description": "Tool invocation payload"
        }
      },
      "required": [
        "tool"
      ]
    },
    "AssistantAuditEntry": {
      "type": "object",
      "description": "Audit record of an AI-assistant edit applied to the flow",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique audit entry identifier"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the entry was recorded"
        },
        "instruction": {
          "type": "string",
          "description": "User instruction that triggered the assistant"
        },
        "message": {
          "type": "string",
          "description": "Assistant response message"
        },
        "provider": {
          "type": "string",
          "description": "LLM provider used"
        },
        "model": {
          "type": "string",
          "description": "LLM model used"
        },
        "source": {
          "type": "string",
          "description": "Origin of the assistant invocation"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Summaries of changes applied"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssistantAuditOperation"
          },
          "description": "Tool operations performed"
        }
      },
      "required": [
        "id",
        "createdAt",
        "instruction",
        "operations"
      ]
    },
    "Position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "description": "X coordinate"
        },
        "y": {
          "type": "number",
          "description": "Y coordinate"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "ActionData": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "Human-readable label"
        },
        "type": {
          "type": "string",
          "description": "Action type identifier"
        },
        "config": {
          "type": "object",
          "description": "Action-specific configuration"
        },
        "image": {
          "type": "string",
          "description": "Screenshot or icon associated with the action"
        },
        "status": {
          "type": "string",
          "description": "Last known execution status of the action"
        },
        "expanded": {
          "type": "boolean",
          "description": "Whether the node is expanded in the canvas UI"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the action (carried on generated/AI nodes)"
        }
      },
      "required": [
        "label",
        "type",
        "config"
      ]
    },
    "Action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique action identifier"
        },
        "type": {
          "type": "string",
          "description": "Action type"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "data": {
          "$ref": "#/$defs/ActionData"
        }
      },
      "required": [
        "id",
        "type",
        "position",
        "data"
      ]
    },
    "Edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique edge identifier"
        },
        "source": {
          "type": "string",
          "description": "Source action ID"
        },
        "sourceHandle": {
          "type": [
            "string",
            "null"
          ],
          "description": "Source handle identifier (null when attached to the default handle)"
        },
        "target": {
          "type": "string",
          "description": "Target action ID"
        },
        "targetHandle": {
          "type": [
            "string",
            "null"
          ],
          "description": "Target handle identifier (null when attached to the default handle)"
        },
        "type": {
          "type": "string",
          "default": "step",
          "description": "Edge type"
        },
        "data": {
          "type": "object",
          "description": "Additional edge data"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ]
    },
    "Zoom": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "description": "Pan X position"
        },
        "y": {
          "type": "number",
          "description": "Pan Y position"
        },
        "zoom": {
          "type": "number",
          "description": "Zoom level"
        }
      },
      "required": [
        "x",
        "y",
        "zoom"
      ]
    },
    "Variable": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Variable identifier"
        },
        "name": {
          "type": "string",
          "description": "Variable name"
        },
        "type": {
          "type": "string",
          "description": "Variable data type"
        },
        "value": {
          "description": "Variable value; any JSON value is allowed (decision 2026-07: runtime stores structured values, aligned with TS JsonValue rather than the old string-only contract)"
        },
        "description": {
          "type": "string",
          "description": "Optional description"
        },
        "isOutput": {
          "type": "boolean",
          "description": "Whether this is an output variable"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "value"
      ]
    },
    "FlowVariables": {
      "type": "object",
      "properties": {
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Variable"
          },
          "description": "Input variables"
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Variable"
          },
          "description": "Output variables"
        }
      },
      "required": [
        "input",
        "output"
      ]
    },
    "FlowParameters": {
      "type": "object",
      "properties": {
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Variable"
          },
          "description": "Input parameters"
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Variable"
          },
          "description": "Output parameters"
        },
        "parameterBefore": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Variable"
          },
          "default": [],
          "description": "Parameters to be set before execution"
        },
        "variableBefore": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Variable"
          },
          "default": [],
          "description": "Variables to be set before execution"
        }
      },
      "required": [
        "input",
        "output"
      ]
    },
    "EnvironmentVariable": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Variable identifier"
        },
        "name": {
          "type": "string",
          "description": "Variable name"
        },
        "type": {
          "type": "string",
          "description": "Variable data type"
        },
        "value": {
          "description": "Variable value; any JSON value is allowed (aligned with TS JsonValue)"
        },
        "description": {
          "type": "string",
          "description": "Optional description"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "value"
      ]
    },
    "Environment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Environment identifier"
        },
        "name": {
          "type": "string",
          "description": "Environment name"
        },
        "variables": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/EnvironmentVariable"
              },
              {
                "$ref": "#/$defs/Variable"
              }
            ]
          },
          "default": null,
          "description": "Environment variables; historical payloads may carry full Variable objects, so both shapes are accepted"
        },
        "description": {
          "type": "string",
          "description": "Environment description"
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this is the default environment"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether this environment is active"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "GlobalVariable": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Variable identifier"
        },
        "name": {
          "type": "string",
          "description": "Variable name"
        },
        "type": {
          "type": "string",
          "description": "Variable data type"
        },
        "value": {
          "description": "Variable value; any JSON value is allowed (aligned with TS JsonValue)"
        },
        "description": {
          "type": "string",
          "description": "Optional description"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "value"
      ]
    }
  }
}
